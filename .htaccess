Options -Indexes

RewriteEngine On

# Bloquea el acceso web a directorios técnicos.
RewriteRule ^(?:\.git|\.github|vendor)(?:/|$) - [F,L,NC]

# Bloquea archivos técnicos que no deben descargarse.
<FilesMatch "^(?:composer\.(?:json|lock)|smtp-config(?:\.example)?\.php|\.gitignore)$">
    Require all denied
</FilesMatch>

# Redirige www hacia el dominio principal.
RewriteCond %{HTTP_HOST} ^www\.orbitalnexusassessors\.com$ [NC]
RewriteRule ^(.*)$ https://orbitalnexusassessors.com/$1 [R=301,L]

# Añade cabeceras generales de seguridad.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>